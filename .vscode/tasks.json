{
    "tasks": [
        {
            "type": "process",
            "label": "EternalRPG: Build",
            "command": "cmake",
            "osx": {
                "command": "/private/tmp/eternalrpg-build-tools/cmake/data/bin/cmake"
            },
            "args": ["--build", "${workspaceFolder}/build"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the entire configured CMake project. macOS currently uses the locally installed CMake."
        },
        {
            "type": "process",
            "label": "EternalRPG: Run",
            "command": "${workspaceFolder}/build/eternal_rpg",
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "EternalRPG: Build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        }
    ],
    "version": "2.0.0"
}
